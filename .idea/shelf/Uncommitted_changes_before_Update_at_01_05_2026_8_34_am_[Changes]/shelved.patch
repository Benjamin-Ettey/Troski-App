+ *     }
+ *
+ *     // defining within the schema
+ *     const s = new Schema({ born: { type: Date, get: dob })
+ *
+ *     // or by retrieving its SchemaType
+ *     const s = new Schema({ born: Date })
+ *     s.path('born').get(dob)
