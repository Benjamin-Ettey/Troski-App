+      }
+      result.writeConcern = writeConcern;
+    }
+  }
+
+  result.timeoutMS = timeoutMS;
+
+  const readPreference = ReadPreference.fromOptions(options) ?? parent?.readPreference;
+  if (readPreference) {
+    result.readPreference = readPreference;
+  }
