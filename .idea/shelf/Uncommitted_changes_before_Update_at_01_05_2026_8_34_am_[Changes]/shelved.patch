+    this.emit(RESPONSE);
+
+    return { server, session, response };
+  }
+
+  override async getMore(): Promise<CursorResponse> {
+    const response = await super.getMore();
+
+    this.maxWireVersion = maxWireVersion(this.server);
+    this._processBatch(response);
