+  var watched = 0;
+  var usedRules = [];
+  var minimatchOpts = {
+    dot: true,
+  };
+
+  // enable case-insensitivity on Windows
+  if (utils.isWindows) {
+    minimatchOpts.nocase = true;
+    minimatchOpts.windowsPathsNoEscape = true;
+  }
+
+  files.forEach(function (file) {
