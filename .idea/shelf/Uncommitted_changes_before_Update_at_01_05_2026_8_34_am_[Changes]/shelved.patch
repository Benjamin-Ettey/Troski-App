+    return this._pinnedServer;
+  }
+
+  get recoveryToken(): Document | undefined {
+    return this._recoveryToken;
+  }
+
+  get isPinned(): boolean {
+    return !!this.server;
+  }
+
+  /**
+   * @returns Whether the transaction has started
