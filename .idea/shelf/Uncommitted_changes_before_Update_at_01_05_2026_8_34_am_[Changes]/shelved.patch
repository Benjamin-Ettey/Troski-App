+
+  type SafeObjectKeys<T> =
+    HasStringIndex<T> extends true ? never : Extract<keyof T, string>;
+
+  type NestedPaths<T, K extends keyof T> =
+    K extends string
+      ? T[K] extends TreatAsPrimitives
