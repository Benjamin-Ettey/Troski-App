+  if (val == null) {
+    return val;
+  }
+  if (val === '') {
+    return null;
+  }
+  if (typeof val === 'bigint') {
+    if (val > MAX_BIGINT || val < MIN_BIGINT) {
+      throw new Error(ERROR_MESSAGE);
+    }
+    return val;
+  }
+
+  if (val instanceof Long) {
+    return val.toBigInt();
+  }
+
+  if (typeof val === 'string' || typeof val === 'number') {
+    val = BigInt(val);
+    if (val > MAX_BIGINT || val < MIN_BIGINT) {
