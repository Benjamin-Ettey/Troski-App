+        infer EnforcedDocType,
+        infer M,
+        infer TInstanceMethods,
+        infer TQueryHelpers,
+        infer TVirtuals,
+        infer TStaticMethods,
+        infer TSchemaOptions,
+        infer DocType,
+        infer THydratedDocumentType,
+        infer TSchemaDefinition,
+        infer TLeanResultType
+      >
