+ * An event published when a connection pool is cleared
+ * @public
+ * @category Event
+ */
+export class ConnectionPoolClearedEvent extends ConnectionPoolMonitoringEvent {
+  /** @internal */
+  serviceId?: ObjectId;
+
+  interruptInUseConnections?: boolean;
+  /** @internal */
+  name = CONNECTION_POOL_CLEARED;
+
+  /** @internal */
