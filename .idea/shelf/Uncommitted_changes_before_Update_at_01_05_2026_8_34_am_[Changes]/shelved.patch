+async function parallelLimit(params, fn, limit) {
+  if (limit <= 0) {
+    throw new Error('Limit must be positive');
+  }
+
+  if (params.length === 0) {
+    return [];
+  }
+
+  const results = [];
+  const executing = new Set();
+
+  for (let index = 0; index < params.length; index++) {
+    const param = params[index];
