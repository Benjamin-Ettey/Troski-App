+      | 'M'
+      | 'TInstanceMethods'
+      | 'TQueryHelpers'
+      | 'TVirtuals'
+      | 'TStaticMethods'
+      | 'TSchemaOptions'
+      | 'DocType'
+      | 'THydratedDocumentType'
+      | 'TSchemaDefinition'
+      | 'TLeanResultType'
