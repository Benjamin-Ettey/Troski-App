+    case 'string':
+      return 1 + ByteUtils.utf8ByteLength(name) + 1 + 4 + ByteUtils.utf8ByteLength(value) + 1;
+    case 'number':
+      if (
+        Math.floor(value) === value &&
+        value >= constants.JS_INT_MIN &&
+        value <= constants.JS_INT_MAX
