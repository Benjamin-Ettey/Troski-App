+ *
+ *     await Model.create({ date: new Date('2016-06-01') });
+ *     const doc = await Model.findOne();
+ *
+ *     doc.date instanceof Date; // true
+ *
+ *     doc.toJSON().date; // 2016 as a number
+ *     JSON.stringify(doc); // '{"_id":...,"date":2016}'
