{
  "info": {
    "name": "Troski Backend",
    "description": "Endpoint coverage for the Troski-Backend project. Import alongside `troski.postman_environment.json`.\n\nCookies are managed by Postman automatically:\n  - signed `signupSession` cookie is set on /verify-signup-otp; required for /set-pin and /confirm-pin.\n  - signed `accessToken` + `refreshToken` cookies are set on /confirm-pin and /login; required for all authenticated endpoints.\n\nSIGN-UP FLOW (new user):\n  1. POST /auth/sign-up               { name, phoneNumber, email }\n  2. POST /auth/verify-signup-otp     { phoneNumber, otpCode }\n  3. POST /auth/set-pin               { pinCode }\n  4. POST /auth/confirm-pin           { pinCode }\n  → user is now logged in. They can call /complete-profile next.\n\nLOGIN FLOW (returning user):\n  POST /auth/login                    { phoneNumber, pinCode }\n\nADMIN: seed first super_admin via `node src/scripts/seedSuperAdmin.js <username> <email> <password>`, then POST /auth/admin/login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "phoneNumber", "value": "0244000001", "type": "string" },
    { "key": "adminUsername", "value": "superadmin", "type": "string" },
    { "key": "adminPassword", "value": "Password123!", "type": "string" },
    { "key": "tripId", "value": "", "type": "string" },
    { "key": "applicationId", "value": "", "type": "string" },
    { "key": "inviteId", "value": "", "type": "string" },
    { "key": "inviteToken", "value": "", "type": "string" },
    { "key": "inviteEmail", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth — User Sign-up",
      "description": "4-step sign-up flow. Steps 1-2 are public; steps 3-4 require the signupSession cookie set by step 2.",
      "item": [
        {
          "name": "1. Sign Up (name + phone + email)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/sign-up",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ama Mensah\",\n  \"phoneNumber\": \"{{phoneNumber}}\",\n  \"email\": \"ama@example.com\"\n}"
            },
            "description": "Creates an unverified user record and sends an OTP via SMS (default; pass method=\"email\" to use email instead). Rate-limited 3/10min per IP. If the phone is already fully registered (PIN set), returns 400."
          }
        },
        {
          "name": "2. Verify Sign-up OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/verify-signup-otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\",\n  \"otpCode\": \"REPLACE_WITH_OTP\"\n}"
            },
            "description": "Validates the OTP and sets a short-lived (15 min) `signupSession` signed cookie. Returns nextStep='set-pin'. NOT a real login yet — the cookie only works for /set-pin and /confirm-pin."
          }
        },
        {
          "name": "3. Set PIN",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/set-pin",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pinCode\": \"123456\"\n}"
            },
            "description": "Requires the signupSession cookie. Stores the (hashed) PIN in `pendingPinCode`. Returns nextStep='confirm-pin'."
          }
        },
        {
          "name": "4. Confirm PIN (account created → real session)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/confirm-pin",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pinCode\": \"123456\"\n}"
            },
            "description": "User re-enters the same PIN. On match: PIN is promoted, signup cookie cleared, REAL accessToken + refreshToken cookies set. Account is now fully created. Returns nextStep='complete-profile'."
          }
        }
      ]
    },
    {
      "name": "Auth — User Login & Session",
      "item": [
        {
          "name": "Login (phone + PIN)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\",\n  \"pinCode\": \"123456\"\n}"
            },
            "description": "Returning users. Rate-limited 10/15min per IP. On match, sets accessToken + refreshToken cookies. Returns nextStep='complete-profile' if the user hasn't filled DOB/photo yet."
          }
        },
        {
          "name": "Complete Profile (DOB + photo)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/complete-profile",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "dateOfBirth", "value": "2000-01-15", "type": "text" },
                { "key": "profilePhoto", "type": "file", "src": [] }
              ]
            },
            "description": "Authenticated. Multipart. dateOfBirth must be 18+. profilePhoto is optional."
          }
        },
        {
          "name": "Verify PIN (gate sensitive in-app actions)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/verify-pin",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pinCode\": \"123456\"\n}"
            },
            "description": "Authenticated. Use to re-confirm PIN before high-risk actions (wallet ops, withdrawals, etc.)."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Auth — Admin (invite-only)",
      "description": "Seed the first super_admin via `node src/scripts/seedSuperAdmin.js`. All further admins must be invited from a logged-in super_admin.",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/admin/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Send Admin Invite (super_admin only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/admin/invite",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newadmin@example.com\",\n  \"role\": \"admin\"\n}"
            }
          }
        },
        {
          "name": "List Outstanding Invites",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/auth/admin/invite" }
        },
        {
          "name": "Verify Invite (public)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/admin/invite/verify?token={{inviteToken}}&email={{inviteEmail}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "admin", "invite", "verify"],
              "query": [
                { "key": "token", "value": "{{inviteToken}}" },
                { "key": "email", "value": "{{inviteEmail}}" }
              ]
            }
          }
        },
        {
          "name": "Register with Invite (public)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/admin/register-with-invite",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{inviteToken}}\",\n  \"email\": \"{{inviteEmail}}\",\n  \"username\": \"newadmin\",\n  \"password\": \"StrongPass1!\"\n}"
            }
          }
        },
        {
          "name": "Revoke Invite",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/auth/admin/invite/{{inviteId}}"
          }
        },
        {
          "name": "Admin Logout",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/auth/admin/logout" }
        }
      ]
    },
    {
      "name": "Driver Application",
      "description": "A logged-in user uploads identity docs to apply to drive. Admin reviews. On approval, a Driver profile is created and 'driver' is added to user.roles.",
      "item": [
        {
          "name": "Submit Application (user)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/driver-application",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "licenseID", "value": "ABC-12345678-1234", "type": "text" },
                { "key": "ghanaCardNumber", "value": "GHA-123456789-1", "type": "text" },
                { "key": "city", "value": "Accra", "type": "text" },
                { "key": "ghanaCardImage", "type": "file", "src": [] },
                { "key": "licenseImage", "type": "file", "src": [] }
              ]
            }
          }
        },
        {
          "name": "Get My Application Status (user)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/driver-application/me" }
        },
        {
          "name": "List Applications (admin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/driver-application/admin?status=pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "driver-application", "admin"],
              "query": [{ "key": "status", "value": "pending" }]
            }
          }
        },
        {
          "name": "Get One Application (admin)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/driver-application/admin/{{applicationId}}"
          }
        },
        {
          "name": "Approve Application (admin)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/driver-application/admin/{{applicationId}}/approve"
          }
        },
        {
          "name": "Reject Application (admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/driver-application/admin/{{applicationId}}/reject",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rejectionReason\": \"Ghana card image is unclear, please re-submit.\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Trip — Passenger",
      "item": [
        {
          "name": "Request Ride (auto-cluster + escrow hold)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.trip && body.trip._id) pm.collectionVariables.set('tripId', body.trip._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/trip/request",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup\": {\n    \"latitude\": 5.6037,\n    \"longitude\": -0.1870,\n    \"name\": \"Accra Mall\"\n  },\n  \"dropoff\": {\n    \"latitude\": 5.6698,\n    \"longitude\": -0.0167,\n    \"name\": \"Tema Station\"\n  }\n}"
            }
          }
        },
        {
          "name": "Get My Active Booking",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/trip/my-booking" }
        },
        {
          "name": "Cancel My Booking (refunds escrow)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/trip/booking/cancel",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Changed plans\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Trip — Driver",
      "item": [
        {
          "name": "List Available Trips",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/trip/available" }
        },
        {
          "name": "Accept Trip",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/v1/trip/{{tripId}}/accept" }
        },
        {
          "name": "Mark Arrived at Pickup",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/v1/trip/{{tripId}}/arrived" }
        },
        {
          "name": "Start Trip",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/v1/trip/{{tripId}}/start" }
        },
        {
          "name": "Complete Trip (settles payouts)",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/v1/trip/{{tripId}}/complete" }
        },
        {
          "name": "Cancel Trip (returns to pool)",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/v1/trip/{{tripId}}/cancel" }
        }
      ]
    },
    {
      "name": "Driver Location",
      "item": [
        {
          "name": "Go Online",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/driver-location/online",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 5.6037,\n  \"longitude\": -0.1870\n}"
            }
          }
        },
        {
          "name": "Update Location",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/driver-location/update",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 5.6100,\n  \"longitude\": -0.1900,\n  \"heading\": 90,\n  \"speed\": 35\n}"
            }
          }
        },
        {
          "name": "Go Offline",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/driver-location/offline" }
        }
      ]
    }
  ]
}
