    {
      "name": "Wallet — User",
      "item": [
        {
          "name": "My Wallet (balance + escrow)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/wallet" }
        },
        {
          "name": "My Wallet Statement",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallet/transactions?limit=25",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "wallet", "transactions"],
              "query": [{ "key": "limit", "value": "25" }]
            }
          }
        },
        {
          "name": "Initiate Top-up",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.reference) pm.collectionVariables.set('topupReference', body.reference);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/wallet/topup/initiate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 50\n}"
            },
            "description": "Returns authorizationURL. Open it in a browser / WebView to complete payment. On success Paystack hits the webhook and your wallet is credited."
          }
        },
        {
          "name": "Verify Top-up (polling fallback)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/wallet/topup/verify/{{topupReference}}",
            "description": "Lets the frontend check 'did the top-up land?' if the user closes the app before the webhook arrives."
          }
        }
      ]
    },
