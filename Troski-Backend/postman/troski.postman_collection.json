        {
          "name": "My Active Trip",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/trip/my-trip" }
        },
        {
          "name": "Incoming Requests",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/trip/incoming-requests" }
