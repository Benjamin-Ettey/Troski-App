          "name": "Cancel My Booking",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/trip/booking/cancel",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Changed my mind\"\n}"
            },
            "description": "Policy: pending → full refund; accepted → 70/30 split (no refund); onboard → not cancellable."
          }
        },
        {
          "name": "Confirm Boarding (passenger enters 4-digit code)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/trip/booking/confirm-boarding",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"8421\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Trip — Driver",
