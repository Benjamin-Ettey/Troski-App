{
  "name": "troski-backend",
  "version": "1.0.0",
  "description": "Backend API for Troski, a Ghanaian shared ride-hailing platform that connects passengers with trotro drivers through route-based ride requests, real-time driver matching, GPS tracking, secure payments, and escrow-based ride transactions.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "jest",
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --clean && copyfiles -u 1 src/docs/**/*.yaml dist",
    "start": "node dist/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [],
  "author": "Troski Technologies",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "datauri": "^4.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.0",
    "morgan": "^1.11.0",
    "multer": "^2.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/helmet": "^0.0.48",
    "@types/http-status-codes": "^1.2.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.3",
    "copyfiles": "^2.4.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
